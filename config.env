# KernelSU Action -- Master Stealth & Performance Profile for POCO X2 (phoenix)
CONFIG_ENV=config.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://github.com/tillua467-s-Playground/android_kernel_xiaomi_phoenix
KERNEL_SOURCE_BRANCH=v2.4
KERNEL_CONFIG=phoenix_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# Hardcodes a pristine kernel name to strip compilation tracking footprints
KERNEL_NAME=Stock-Stealth
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false

USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# =============================================================== KernelSU ===
KSU_VARIANT=resukisu
KSU_REF=main
KSU_HOOK_MODE=kprobes

# =================================================================== SUSFS ==
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=kernel-4.14

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true

# Enables advanced link-time compilation optimizations for fluidity
DISABLE_LTO=false

# Prevents the compiler from halting on loose legacy driver warnings
DISABLE_CC_WERROR=true

# Bakes the KProfiles hardware driver natively into the kernel runtime code
EXTRA_DEFCONFIG=CONFIG_KPROFILES=y

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false

# ============================================================== Packaging ===
# Compiles matching device tree overlays to protect touch panel polling rates
NEED_DTBO=true
BUILD_BOOT_IMG=false

# ================================================================ Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
